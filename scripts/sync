#
# sync directories defined in BACKUP_DIR in s3 object
# rclone tool need configuration access to write/read in bucket
#


run() {
  ret=${__RETURNCODE_SCRIPT_NOTHING}
  HOSTNAME="$(/bin/hostname -f)"

  __log_script_msg sync "starting synchronization for ${HOSTNAME}\n"

  ! ${SYNC_RUN_BACKUP} && {  # skip synchronization
    __log_script_msg sync "skipping synchronization for ${HOSTNAME}\n"

    return ${ret}
  }

  checking_vars

  backup_dir=${RCLONE_BACKUP_REMOTE}/${HOSTNAME}/sync
  increment=${backup_dir}${__s3_increment}/${_CURRENT_DATE}

  for dir in ${BACKUP_DIR[@]}; do
    main="${backup_dir}/main${dir}"
    rclone_options=("--backup-dir=${increment}")

    /usr/bin/rclone --config=${_CONFIG_RCLONE} "${RCLONE_EXTRA_OPTIONS[@]}" sync ${rclone_options[@]} ${dir} ${main}

    __log_script_msg sync "${dir} directory synchronization completed\n"
  done

  __log_script_msg sync "finish synchronization for ${HOSTNAME}\n"
  __log_script_msg sync "retentions ${#_retention_dates[@]} of ${SYNC_KEEP_LAST_INCREMENT:-unlimit}\n"

  [ ${SYNC_KEEP_LAST_INCREMENT:-0} -ne 0 ] && {
    __keep_last_backups --mode=${SYNC_BACKUP_MODE} \
                        --s3-path=${backup_dir} \
                        --increment-keep=${SYNC_KEEP_LAST_INCREMENT}
  }

  return ${ret}
}


checking_vars() {
  [ -z "${BACKUP_DIR}" ] && {
    __log_script_msg sync "${__FAIL} BACKUP_DIR not defined, cannot run the script\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ "${SYNC_BACKUP_MODE}" != "${__BACKUP_MODE_INCREMENT}" ] && {
    __log_script_msg sync "${__FAIL} backup mode not support, support SYNC_BACKUP_MODE=${__BACKUP_MODE_INCREMENT}\n"

    return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
  }

  return ${__RETURNCODE_OK}
}
