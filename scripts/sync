#
# sync directories defined in BACKUP_DIR in s3 object
# rclone tool need configuration access to write/read in bucket
#


run() {
  ret=${__RETURNCODE_SCRIPT_NOTHING}
  HOSTNAME="$(/bin/hostname -f)"

  __log_script_msg sync "starting synchronization for ${HOSTNAME}\n"

  ! ${SYNC_RUN_BACKUP} && {  # skip synchronization
    __log_script_msg sync "skipping synchronization for ${HOSTNAME}\n"

    return ${ret}
  }

  checking_global_vars
  checking_vars

  backup_dir="${RCLONE_BACKUP_REMOTE}/${HOSTNAME}/sync"
  increment="${backup_dir}/increment/${__NOW_DATE}"

  for dir in ${BACKUP_DIR[@]}; do
    main="${backup_dir}/main${dir}"
    rclone_options=("--backup-dir=${increment}")

    /usr/bin/rclone --config=${_CONFIG_RCLONE} "${RCLONE_EXTRA_OPTIONS[@]}" sync ${rclone_options[@]} ${dir} ${main}

    __log_script_msg sync "${dir} directory synchronization completed\n"
  done

  __log_script_msg sync "finish synchronization for ${HOSTNAME}\n"
  __log_script_msg sync "retentions ${#_retention_dates[@]} of ${ :-unlimit}\n"

  [ ${_SYNC_KEEP_LAST_BACKUPS:-0} -ne 0 ] && {
    __keep_last_backups ${backup_dir}/increment
  }

  return ${ret}
}


# $1 => path to increment directories
__keep_last_backups() {
  local __remote_dir=$1

  __log_script_msg sync "keep backups in ${__remote_dir}\n"

  local _retention_dates=($(/usr/bin/rclone --config=${_CONFIG_RCLONE} lsd ${__remote_dir} | \
                            /usr/bin/awk '{print $5}' | \
                            /usr/bin/sort))

  while [ ${#_retention_dates[@]} -gt ${_SYNC_KEEP_LAST_BACKUPS} ]; do
    local __remove_filename=${__remote_dir}/${_retention_dates[0]}

    __log_script_msg sync "trying remove directory ${__remove_filename}\n"
    /usr/bin/rclone --config=${_CONFIG_RCLONE} delete ${__remove_filename}
    [ $? -ne 0 ] && {
      __log_script_msg sync "${__FAIL} can not remove ${__remove_filename}\n"
    }

    local _retention_dates=(${_retention_dates[@]:1:${#_retention_dates[@]}})  # remove first element
  done
}


checking_vars() {
  [ -z "${BACKUP_DIR}" ] && {
    __log_script_msg sync "${__FAIL} BACKUP_DIR not defined, cannot run the script\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  local _envs=(/bin/env)

  return ${__RETURNCODE_OK}
}
