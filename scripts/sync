#
# sync directories defined in BACKUP_DIR in s3 object
# rclone tool need configuration access to write/read in bucket
#


run() {
  ! __run_script && {
    __log_script_msg --script-name="sync" --icon="${__INFO}" --msg="skipping backup files for for ${_HOSTNAME}"

    return ${__RETURNCODE_SCRIPT_NOTHING}
  }

  local __directory=${_RCLONE_REMOTE_BACKUP}/${_HOSTNAME}/sync
  local ret=${__RETURNCODE_OK}

  __log_script_msg --script-name="sync" --icon="${__INFO}" --msg="synchronization is starting for ${_HOSTNAME}"

  for directory in ${_BACKUP_DIRECTORIES[@]}; do
    __rclone_sync_run \
      --s3-path=${__directory} \
      --directory=${directory} \
      --keep-increment=${_KEEP_LAST_INCREMENT} &>> ${_LOGFILE}

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="sync" --icon="${__FAIL}" --msg="synchronization ${directory}"

      local ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __log_script_msg --script-name="sync" --icon="${__INFO}" --msg="synchronization ${directory} completed"
  done

  __log_script_msg --script-name="sync" --icon="${__INFO}" --msg="end synchronization files"

  [ ${ret} -eq ${__RETURNCODE_OK} ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --increment-keep=${_KEEP_LAST_INCREMENT}
  }

  return ${ret}
}


checking_vars() {
  [ -z "${_BACKUP_DIRECTORIES}" ] && {
    __log_script_msg --script-name="sync" --icon="${__FAIL}" --msg="_BACKUP_DIRECTORIES not defined, cannot run the script"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ "${_BACKUP_MODE}" != "${__BACKUP_MODE_INCREMENT}" ] && {
    __log_script_msg --script-name="sync" --icon="${__FAIL}" --msg="backup mode not support, support _BACKUP_MODE=${__BACKUP_MODE_INCREMENT}"

    return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
  }

  return ${__RETURNCODE_OK}
}
