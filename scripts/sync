#
# sync directories defined in BACKUP_DIR in s3 object
# rclone tool need configuration access to write/read in bucket
#


run() {
  ret=${__RETURNCODE_SCRIPT_NOTHING}
  HOSTNAME="$(/bin/hostname -f)"

  __log_script_msg sync "starting synchronization for ${HOSTNAME}\n"

  ! ${_RUN_BACKUP} && {  # skip synchronization
    __log_script_msg sync "skipping synchronization for ${HOSTNAME}\n"

    return ${ret}
  }

  local __directory=${_RCLONE_REMOTE_BACKUP}/${HOSTNAME}/sync

  for directory in ${_BACKUP_DIR[@]}; do
    __rclone_sync_run \
      --s3-path=${__directory} \
      --directory=${directory} \
      --keep-increment=${_KEEP_LAST_INCREMENT} &> ${_LOGDIR}/sync.log-${_CURRENT_DATE}

    [ $? -ne 0 ] && {
      __log_script_msg sync "${__FAIL} synchronization ${directory} failure\n"

      continue
    }

    __log_script_msg sync "synchronization ${directory} completed\n"
  done

  __log_script_msg sync "finish synchronization for ${HOSTNAME}\n"
  __log_script_msg sync "retentions ${#_retention_dates[@]} of ${_KEEP_LAST_INCREMENT:-unlimit}\n"

  [ ${_KEEP_LAST_INCREMENT:-0} -ne 0 ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --increment-keep=${_KEEP_LAST_INCREMENT}
  }

  return ${ret}
}


checking_vars() {
  [ -z "${_BACKUP_DIR}" ] && {
    __log_script_msg sync "${__FAIL} _BACKUP_DIR not defined, cannot run the script\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ "${_BACKUP_MODE}" != "${__BACKUP_MODE_INCREMENT}" ] && {
    __log_script_msg sync "${__FAIL} backup mode not support, support _BACKUP_MODE=${__BACKUP_MODE_INCREMENT}\n"

    return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
  }

  return ${__RETURNCODE_OK}
}
