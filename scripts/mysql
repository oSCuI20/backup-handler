#
# MySQL backups
#
#


run() {
  ! __run_script && {
    __log_script_msg --script-name="mysql" --icon=${__INFO} --msg="skipping MySQL backups for ${_HOSTNAME}\n"

    return ${__RETURNCODE_SCRIPT_NOTHING}
  }

  __log_script_msg --script-name="mysql" --icon=${__INFO} --msg="MySQL backups is starting for ${_HOSTNAME}\n"

  local __directory="${_RCLONE_REMOTE_BACKUP}/${_HOSTNAME}/mysql"

  local _mysql_options=(
    -h ${MYSQL_HOST}
    -u ${MYSQL_USER}
    -P ${MYSQL_PORT}
    -p${MYSQL_PASS}
  )
  local _dump_options=(
    --single-transaction
    --triggers
    --routines
  )
  local _gzip_options=(
    --best
    --force
    --quiet
  )
  local _tmpdir=${_TMPDIR}

  local _databases=(${MYSQL_DATABASES[@]})

  [ -z "${_databases[@]}" ] && {
    local _databases=$(/usr/bin/mysql -N ${_mysql_options[@]} -e "SHOW DATABASES;")

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="backups for databases: ${_databases[@]}\n"

      return ${__RETURNCODE_SCRIPT_ERROR_ANY}
    }
  }

  /bin/mkdir -p ${_tmpdir}

  for ignore in ${MYSQL_DATABASES_IGNORE[@]}; do
    local _databases=(${_databases[@]/${ignore}/})
  done

  __log_script_msg --script-name="mysql" --icon=${__INFO} --msg="running backup of databases: ${_databases[@]}\n"

  local ret=${__RETURNCODE_OK}

  for database in ${_databases[@]}; do
    /usr/bin/mysqldump ${_mysql_options[@]} ${_dump_options[@]} --databases ${database} | \
      /bin/gzip ${_gzip_options[@]} > ${_tmpdir}/${database}.sql.gz

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="backup of database: ${database}\n"

      ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __rclone_copy_complete \
      --s3-path=${__directory} \
      --file=${_tmpdir}/${database}.sql.gz \
      --keep-daily=${_KEEP_LAST_DAILY} \
      --keep-weekly=${_KEEP_LAST_WEEKLY} \
      --keep-monthly=${_KEEP_LAST_MONTHLY} \
      --keep-annually=${_KEEP_LAST_ANNUALLY} &>> ${_LOGFILE}

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="uploading database: ${database}\n"

      ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __log_script_msg --script-name="mysql" --icon=${__INFO} --msg="$(/bin/rm -fv ${_tmpdir}/${database}.sql.gz)\n"
  done

  __log_script_msg --script-name="mysql" --icon=${__INFO} --msg="end MySQL backups\n"

  [ ${ret} -eq ${__RETURNCODE_OK} ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --complete-keep-daily=${_KEEP_LAST_DAILY} \
                        --complete-keep-weekly=${_KEEP_LAST_WEEKLY} \
                        --complete-keep-monthly=${_KEEP_LAST_MONTHLY} \
                        --complete-keep-annually=${_KEEP_LAST_ANNUALLY}
  }

  return ${ret}
}


checking_vars() {
  [ ! -f /usr/bin/mysql ]  && {
    __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="/usr/bin/mysql command not found\n"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ -n "${_BACKUP_MODE}" ] && {
    [ "${_BACKUP_MODE}" != "${__BACKUP_MODE_COMPLETE}" ] && {
      __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="backup mode not support, support _BACKUP_MODE=${__BACKUP_MODE_COMPLETE}\n"

      return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
    }
  }

  [ ! -f /usr/bin/mysqldump ]  && {
    __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="/usr/bin/mysqldump command not found\n"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ -z "${MYSQL_USER}" ] && {
    __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="MYSQL_USER is undefined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_PASS}" ] && {
    __log_script_msg --script-name="mysql" --icon=${__FAIL} --msg="MYSQL_PASS is undefined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_HOST}" ] && {
    MYSQL_HOST=localhost

    __log_script_msg --script-name="mysql" --icon=${__WARN} --msg="MYSQL_HOST is undefined, default ${MYSQL_HOST}\n"
  }

  [ -z "${MYSQL_PORT}" ] && {
    MYSQL_PORT=3306

    __log_script_msg --script-name="mysql" --icon=${__WARN} --msg="MYSQL_PORT is undefined, default ${MYSQL_PORT}\n"
  }

  [ -z "${MYSQL_DATABASES_IGNORE[@]}" ] && {
    MYSQL_DATABASES_IGNORE=(information_schema performance_schema mysql)

    __log_script_msg --script-name="mysql" --icon=${__WARN} --msg="MYSQL_DATABASES_IGNORE is undefined, ignore default databases: ${MYSQL_DATABASES_IGNORE[@]}\n"
  }

  return ${__RETURNCODE_OK}
}
