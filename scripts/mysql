#
# MySQL backups
#
#


run() {
  HOSTNAME="$(/bin/hostname -f)"

  __log_script_msg mysql "starting MySQL backups for ${HOSTNAME}\n"

  ! ${_RUN_BACKUP} && {
    __log_script_msg mysql "skipping MySQL backups for ${HOSTNAME}\n"

    return ${__RETURNCODE_SCRIPT_NOTHING}
  }

  local __directory="${_RCLONE_REMOTE_BACKUP}/${HOSTNAME}/mysql"

  local _mysql_options=(
    -h ${MYSQL_HOST}
    -u ${MYSQL_USER}
    -P ${MYSQL_PORT}
    -p${MYSQL_PASS}
  )
  local _dump_options=(
    --single-transaction
    --triggers
    --routines
  )
  local _gzip_options=(
    --best
    --force
    --quiet
  )
  local _tmpdir=${_TMPDIR}

  local _databases=(${MYSQL_DATABASES[@]})

  [ -z "${_databases[@]}" ] && {
    local _databases=$(/usr/bin/mysql -N ${_mysql_options[@]} -e "SHOW DATABASES;")

    [ $? -ne 0 ] && {
      __log_script_msg mysql "${__FAIL} ${_databases[@]}\n"

      return ${__RETURNCODE_SCRIPT_ERROR_ANY}
    }
  }

  /bin/mkdir -p ${_tmpdir}

  for ignore in ${MYSQL_DATABASES_IGNORE[@]}; do
    local _databases=(${_databases[@]/${ignore}/})
  done

  __log_script_msg mysql "running backup of databases ${_databases[@]}\n"

  local ret=${__RETURNCODE_OK}

  for database in ${_databases[@]}; do
    /usr/bin/mysqldump ${_mysql_options[@]} ${_dump_options[@]} --databases ${database} | \
      /bin/gzip ${_gzip_options[@]} > ${_tmpdir}/${database}.sql.gz

    __rclone_copy_complete \
      --s3-path=${__directory} \
      --file=${_tmpdir}/${database}.sql.gz \
      --keep-daily=${_KEEP_LAST_DAILY} \
      --keep-weekly=${_KEEP_LAST_WEEKLY} \
      --keep-monthly=${_KEEP_LAST_MONTHLY} \
      --keep-annually=${_KEEP_LAST_ANNUALLY} &> ${_LOGDIR}/mysql.log-${_CURRENT_DATE}

    [ $? -ne 0 ] && {
      __log_script_msg mysql "${__FAIL} database backup failed! ${database}\n"

      ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __log_script_msg mysql "$(/bin/rm -fv ${_tmpdir}/${database}.sql.gz)\n"
  done

  __log_script_msg mysql "finish backup of databases\n"

  [ ${ret} -eq ${__RETURNCODE_OK} ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --complete-keep-daily=${_KEEP_LAST_DAILY} \
                        --complete-keep-weekly=${_KEEP_LAST_WEEKLY} \
                        --complete-keep-monthly=${_KEEP_LAST_MONTHLY} \
                        --complete-keep-annually=${_KEEP_LAST_ANNUALLY}
  }

  return ${ret}
}


checking_vars() {
  [ ! -f /usr/bin/mysql ]  && {
    __log_script_msg mysql "${__FAIL} /usr/bin/mysql command not found\n"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ -n "${_BACKUP_MODE}" ] && {
    [ "${_BACKUP_MODE}" != "${__BACKUP_MODE_COMPLETE}" ] && {
      __log_script_msg mysql "${__FAIL} backup mode not support, support _BACKUP_MODE=${__BACKUP_MODE_COMPLETE}\n"

      return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
    }
  }

  [ ! -f /usr/bin/mysqldump ]  && {
    __log_script_msg mysql "${__FAIL} /usr/bin/mysqldump command not found\n"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ -z "${MYSQL_USER}" ] && {
    __log_script_msg mysql "${__FAIL} MYSQL_USER not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_PASS}" ] && {
    __log_script_msg mysql "${__FAIL} MYSQL_PASS not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_HOST}" ] && {
    MYSQL_HOST=localhost

    __log_script_msg mysql "${__WARN} MYSQL_HOST not defined, set default port ${MYSQL_HOST}\n"
  }

  [ -z "${MYSQL_PORT}" ] && {
    MYSQL_PORT=3306

    __log_script_msg mysql "${__WARN} MYSQL_PORT not defined, set default port ${MYSQL_PORT}\n"
  }

  [ -z "${MYSQL_DATABASES_IGNORE[@]}" ] && {
    MYSQL_DATABASES_IGNORE=(information_schema performance_schema mysql)

    __log_script_msg mysql "${__WARN} MYSQL_DATABASES_IGNORE not defined, ignore default database ${MYSQL_DATABASES_IGNORE[@]}\n"
  }

  return ${__RETURNCODE_OK}
}
