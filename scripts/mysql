checking_vars() {
  [ -z "${MYSQL_USER}" ] && {
    __log_script_msg mysql "${__FAIL} MYSQL_USER not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_PASS}" ] && {
    __log_script_msg mysql "${__FAIL} MYSQL_PASS not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_PORT}" ] && {
    MYSQL_PORT=3306

    __log_script_msg mysql "${__WARN} MYSQL_PORT not defined, set default port ${MYSQL_PORT}\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${MYSQL_IGNORE}" ] && [ -n "${MYSQL_DATABASES}" ] && {
    MYSQL_IGNORE="(information_schema|performance_schema|mysql)"

    __log_script_msg mysql "${__WARN} MYSQL_IGNORE not defined, ignore default database ${MYSQL_IGNORE}\n"
  }
}
