checking_vars() {
  [ -z "${_BACKUP_FILES}" ] && {
    __log_script_msg files "${__FAIL} _BACKUP_FILES not defined, cannot run the script\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  return ${__RETURNCODE_OK}
}
