#
# Postgresql backups
#
#


run() {
  ! __run_script && {
    __log_script_msg --script-name="pgsql" --icon="${__INFO}" --msg="skipping PostgreSQL backups for ${_HOSTNAME}"

    return ${__RETURNCODE_SCRIPT_NOTHING}
  }

  __log_script_msg --script-name="pgsql" --icon="${__INFO}" --msg="PostgreSQL backups is starting for ${_HOSTNAME}"

  local __directory="${_RCLONE_REMOTE_BACKUP}/${_HOSTNAME}/postgresql/${__NOW_DATE}"

  local _psql_options=(
    -h ${POSTGRESQL_HOST}
    -U ${POSTGRESQL_USER}
    -p ${POSTGRESQL_PORT}
  )
  local _dump_options=(
    --clean
  )
  local _gzip_options=(
    --best
    --force
    --quiet
  )
  local _tmpdir=${_TMPDIR}

  local _databases=(${POSTGRESQL_DATABASES[@]})

  [ -z "${_databases[@]}" ] && {
    local _databases=$(/usr/bin/psql -t -U postgres -c "SELECT datname FROM pg_database WHERE datistemplate = false;")

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="backups for databases: ${_databases[@]}"

      return ${__RETURNCODE_SCRIPT_ERROR_ANY}
    }
  }

  for ignore in ${POSTGRESQL_DATABASES_IGNORE[@]}; do
    local _databases=(${_databases[@]/${ignore}/})
  done

  __log_script_msg --script-name="pgsql" --icon="${__INFO}" --msg="running backup of databases: ${_databases[@]}"

  local ret=${__RETURNCODE_OK}
  for database in ${_databases[@]}; do
    /usr/bin/pg_dump ${_psql_options[@]} ${_dump_options[@]} --databases ${database} | \
      /bin/gzip ${_gzip_options[@]} > ${_tmpdir}/${database}.sql.gz

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="backup of database: ${database}"

      ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __rclone_copy_complete \
      --s3-path=${__directory} \
      --file=${_tmpdir}/${database}.sql.gz \
      --keep-daily=${_KEEP_LAST_DAILY} \
      --keep-weekly=${_KEEP_LAST_WEEKLY} \
      --keep-monthly=${_KEEP_LAST_MONTHLY} \
      --keep-annually=${_KEEP_LAST_ANNUALLY} &>> ${_LOGFILE}

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="uploading database: ${database}"

      ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __log_script_msg --script-name="pgsql" --icon="${__INFO}" --msg="$(/bin/rm -fv ${_tmpdir}/${database}.sql.gz)"
  done

__log_script_msg --script-name="pgsql" --icon="${__INFO}" --msg="end PostgreSQL backups"

  [ ${ret} -eq ${__RETURNCODE_OK} ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --complete-keep-daily=${_KEEP_LAST_DAILY} \
                        --complete-keep-weekly=${_KEEP_LAST_WEEKLY} \
                        --complete-keep-monthly=${_KEEP_LAST_MONTHLY} \
                        --complete-keep-annually=${_KEEP_LAST_ANNUALLY}
  }

  return ${ret}
}


checking_vars() {
  [ ! -f /usr/bin/psql ]  && {
    __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="/usr/bin/psql command not found"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ ! -f /usr/bin/pg_dump ]  && {
    __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="/usr/bin/pg_dump command not found"

    return ${__RETURNCODE_SCRIPT_ERROR_ANY}
  }

  [ -z "${POSTGRESQL_USER}" ] && {
    __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="POSTGRESQL_USER is undefined"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${POSTGRESQL_PASS}" ] && {
    __log_script_msg --script-name="pgsql" --icon="${__FAIL}" --msg="POSTGRESQL_PASS is undefined"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${POSTGRESQL_HOST}" ] && {
    POSTGRESQL_HOST=localhost

    __log_script_msg --script-name="pgsql" --icon="${__WARN}" --msg="POSTGRESQL_HOST is undefined, default ${POSTGRESQL_HOST}"
  }

  [ -z "${POSTGRESQL_PORT}" ] && {
    POSTGRESQL_PORT=3306

    __log_script_msg --script-name="pgsql" --icon="${__WARN}" --msg="POSTGRESQL_PORT is undefined, default ${POSTGRESQL_PORT}"
  }

  [ -z "${POSTGRESQL_DATABASES_IGNORE[@]}" ] && {
    POSTGRESQL_DATABASES_IGNORE=(postgres template0 template1)

    __log_script_msg --script-name="pgsql" --icon="${__WARN}" --msg="POSTGRESQL_DATABASES_IGNORE is undefined, ignore default database: ${POSTGRESQL_DATABASES_IGNORE[@]}"
  }

  return ${__RETURNCODE_OK}
}
