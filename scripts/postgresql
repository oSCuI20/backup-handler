#
# Postgresql backups
#
#


run() {
  ret=${__RETURNCODE_SCRIPT_NOTHING}
  HOSTNAME="$(/bin/hostname -f)"

  __log_script_msg postgresql "starting backup files for ${HOSTNAME}\n"

  ! ${_RUN_BACKUP_POSTGRESQL} && {
    __log_script_msg postgresql "skipping backup files for ${HOSTNAME}\n"

    return ${ret}
  }

  backup_dir="${RCLONE_BACKUP_REMOTE}/${HOSTNAME}/postgresql"

  for dir in ${BACKUP_DIR[@]}; do
    main="${backup_dir}/main${dir}"
    increment="${backup_dir}/increment/${__NOW_DATE}"

    __log_script_msg postgresql "finish backup ${dir}\n"
  done  #for dir in ${BACKUP_DIR[@]}

  __log_script_msg postgresql "finish backup files ${HOSTNAME}\n"

  return ${ret}
}


checking_vars() {
  [ "${BACKUP_DIR}" == "" ] && {
    __log_script_msg postgresql "${__FAIL} BACKUP_DIR not defined, cannot run the script\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  return ${__RETURNCODE_OK}
}
