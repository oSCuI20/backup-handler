#
# VirtualBox backups VM
#
#


run() {
  ! __run_script && {
    __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="skipping virtualbox backups for ${_HOSTNAME}"

    return ${__RETURNCODE_SCRIPT_NOTHING}
  }

  __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="synchronization is starting for ${_HOSTNAME}"

  local __directory=${_RCLONE_REMOTE_BACKUP}/${_HOSTNAME}/virtualbox
  local _tmpdir=${_TMPDIR}

  local ret=${__RETURNCODE_OK}

  for vm in ${VBOX_VMS[@]}; do
    local _vmvboxpath=${VBOX_PATH}/${vm}
    local _tmpfile=${_tmpdir}/${vm}.tar.gz

    /bin/su -l vbox -c "/usr/bin/VBoxManage showvminfo ${vm}" | \
      /bin/grep -q running && {
      __log_script_msg --script-name="vbox" --icon="${__FAIL}" --msg="the virtual machine ${vm} is running or not exists"

      local ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    /bin/tar -czf "${_tmpfile}" -C "${_vmvboxpath}" .
    local _return_tar=$?

    /bin/su -l vbox -c "/usr/bin/VBoxManage startvm ${vm} --type headless" && \
      __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="${__OK} ${vm} started sucessful" || \
      __log_script_msg --script-name="vbox" --icon="${__FAIL}" --msg="${vm} can not started"

    [ ${_return_tar} -ne 0 ] && {
      __log_script_msg --script-name="vbox" --icon="${__FAIL}" --msg="cannot compress directory ${_vmvboxpath} - cmd(/bin/tar -czf ${_tmpfile} -C ${_vmvboxpath}) ."

      local ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __rclone_copy_complete \
      --s3-path=${__directory} \
      --file=${_tmpfile} \
      --keep-daily=${_KEEP_LAST_DAILY} \
      --keep-weekly=${_KEEP_LAST_WEEKLY} \
      --keep-monthly=${_KEEP_LAST_MONTHLY} \
      --keep-annually=${_KEEP_LAST_ANNUALLY} &>> ${_LOGFILE}

    [ $? -ne 0 ] && {
      __log_script_msg --script-name="vbox" --icon="${__FAIL}" --msg="${vm} backup failed!"

      local ret=${__RETURNCODE_SCRIPT_ERROR_ANY}
      continue
    }

    __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="$(/bin/rm -fv ${_tmpfile})"
  done

  __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="end PostgreSQL backups"

  [ ${ret} -eq ${__RETURNCODE_OK} ] && {
    __keep_last_backups --mode=${_BACKUP_MODE} \
                        --s3-path=${__directory} \
                        --complete-keep-daily=${_KEEP_LAST_DAILY} \
                        --complete-keep-weekly=${_KEEP_LAST_WEEKLY} \
                        --complete-keep-monthly=${_KEEP_LAST_MONTHLY} \
                        --complete-keep-annually=${_KEEP_LAST_ANNUALLY}
  }

  return ${ret}
}


checking_vars() {
  [ "${_BACKUP_MODE}" != "${__BACKUP_MODE_COMPLETE}" ] && {
    __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="${__FAIL} backup mode not support, support _BACKUP_MODE=${__BACKUP_MODE_COMPLETE}"

    return ${__RETURNCODE_SCRIPT_BACKUP_MODE_NOT_SUPPORT}
  }

  [ -z "${VBOX_VMS}" ] && {
    __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="${__FAIL} VBOX_VMS not defined"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${VBOX_PATH}" ] && {
    __log_script_msg --script-name="vbox" --icon="${__INFO}" --msg="${__FAIL} VBOX_PATH not defined"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  return ${__RETURNCODE_OK}
}
