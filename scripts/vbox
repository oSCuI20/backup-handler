checking_vars() {
  [ -z "${VBOX_VM}" ] && {
    __log_script_msg vbox "${__FAIL} VBOX_VM not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  [ -z "${VBOX_PATH}" ] && {
    __log_script_msg vbox "${__FAIL} VBOX_PATH not defined\n"

    return ${__RETURNCODE_SCRIPT_VARS_NOT_DEFINED}
  }

  return ${__RETURNCODE_OK}
}
