

send_notification() {
  local message="$@"
  local curl_options=(--get --silent)
  local _url="${_TELEGRAM_API}/bot${_TELEGRAM_TOKEN}"

  ${_TELEGRAM_DEBUG} && {
    local curl_options=(--get --verbose)
  }

  [ -z ${_TELEGRAM_TOKEN} ] && \
    printf "%s\n" "TELEGRAM_TOKEN undefined"

  [ -z ${_TELEGRAM_CHAT_ID} ] && \
    printf "%s\n" "TELEGRAM_CHAT_ID undefined"


  [ -n "${_TELEGRAM_TOKEN}" ] && [ -n "${_TELEGRAM_CHAT_ID}" ] && {
    local _url_params="--data-urlencode \"chat_id=${_TELEGRAM_CHAT_ID}\" --data-urlencode \"text=${message}\""

    curl ${curl_options[@]} ${_url_params} "${_url}/sendMessage"
  }
}
