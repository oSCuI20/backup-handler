# Utils for handler.sh

__OK=Success:
__FAIL=Failure:
__ERROR=Error:
__WARN=Warning:
__INFO=Info:
__NOTHING=${__INFO}

## Logging functions
__logger() {
  local __icon=$1
  local __msg=(${@/${__icon}/})

  echo -en "${__icon} ${__msg[@]}"

  [ "${__icon}" == "${__ERROR}" ] && exit 1

  return 0
}


# $1 -> script name
# $@ -> message
__log_script_msg() {
  local __script_name=$1
  local __msg=$(echo $@ | sed -e "s/^${__script_name} //g")
  local __logfile=${_LOGDIR}/${__script_name}.log-${__NOW_DATE}

  local msg=${__NOTHING}"[$(/bin/date '+%Y-%m-%d %H:%M:%S')] [${__script_name}] ${__msg[@]}"

  __logger ${msg}

  ${_LOGGING} && __logger ${msg} >> ${__logfile}
}


__locked() {
  [ ! -d "${_PIDFILE%/*}" ] && /bin/mkdir -p "${_PIDFILE%/*}"
  [ ! -f "${_PIDFILE}" ] && /bin/touch "${_PIDFILE}"
  local pid=$(/bin/cat "${_PIDFILE}")
  local process=$(/bin/ps ax -o pid,comm)
  local retval=0

  if /usr/bin/printf "${process}" | /bin/grep -q "${pid}" && \
     [ -n "${pid}" ]; then
    __logger ${__ERROR} "Found a proccess ${pid}\n"
  fi

  /bin/echo $$ > "${_PIDFILE}"
}


__send_notification() {
  #_send_email "email_addr" "subject" "Message" "email_cc"
  local email_to="$1"
  local subject="$2"
  local message="$3"
  local email_cc="$4"
  local email_from="backup@`/bin/hostname -f`"
  {
    /bin/printf "From: ${email_from}\n"
    /bin/printf "To: ${email_to}\n"
    [ -n "${email_cc}" ] && /bin/printf "CC: ${email_cc}\n"
    /bin/printf "Subject: ${subject}\n"
    /bin/printf "X-Mailer: Backup\n"
    /bin/printf "MIME-Version: 1.0\n"
    /bin/printf "Content-Transfer-Encoding: 8bit\n"
    /bin/printf "Content-Type: text/plain; charset=UTF-8\n"
    /bin/echo ""
    /bin/cat "${message}"
  } | /usr/sbin/sendmail -oi -t
}


__ssh() {
  ##  _ssh_exec(). Execute remote command.
  ##  Params => --host=, --user=, --keyfile=, --cmd=
  while [ $# -ge 1 ]; do
    local key=$1
    case $key in
      --host=*)
        local host="${key#*=}"
        ;;
      --user=*)
        local user="${key#*=}"
        ;;
      --keyfile=*)
        local keyfile="${key#*=}"
        ;;
      --port=*)
        local port=${key#*=}
        ;;
      --cmd=*)
        local cmd="${key#*=}"
        ;;
    esac
    shift
  done

  [ -z "${port}" ] && {
    local port=22
  }

  [ -z "${user}" ] && {
    local user=$(/usr/bin/id -un)
    __logger ${__WARN} Use default user => ${user}\n
  }

  [ -z "${host}" ] && {
    __logger ${__FAIL} host not defined\n
  }

  [ -z "${keyfile}" ] && {
    __logger ${__FAIL} keyfile not defined\n
  }

  [ -z "${keyfile}" ] && [ ! -f "${keyfile}" ] && {
    __logger ${__FAIL} keyfile not found ${keyfile}\n
  }

  [ -z "${cmd}" ] && {
    __logger ${__FAIL} command not defined\n
  }

  local retval=${__RETURNCODE_SSH_FAILED_ARGUMENTS}

  [ -n "${host}" ] && [ -n "${keyfile}" ] && [ -n "${cmd}" ] && {
    /usr/bin/ssh -i "${keyfile}" -p ${port} ${user}@${host} "${cmd}"

    local retval=$?
  }

  return ${retval}
}

__BACKUP_MODE_INCREMENT=increment
__BACKUP_MODE_COMPLETE=complete

__s3_increment=/${__BACKUP_MODE_INCREMENT}
__s3_complete_annually=/${__BACKUP_MODE_COMPLETE}/annually
__s3_complete_monthly=/${__BACKUP_MODE_COMPLETE}/monthly
__s3_complete_weekly=/${__BACKUP_MODE_COMPLETE}/weekly
__s3_complete_daily=/${__BACKUP_MODE_COMPLETE}/daily


__rclone_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --command=*)
        local _command="${key#*=}"
        ;;
      --extra=*)
        local _extra="${key#*=}"
        ;;
      --args=*)
        local _args="${key#*=}"
        ;;
    esac
    shift
  done

  /usr/bin/rclone ${_RCLONE_EXTRA_OPTIONS[@]} \
    --config=${_CONFIG_RCLONE} \
    ${_command} ${_extra} ${_args}

  return $?
}

__rclone_sync_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --directory=*)
        local _localdir="${key#*=}"
        ;;
      --keep-increment=*)
        local _keep_last_increment="${key#*=}"
        ;;
    esac
    shift
  done

  [ ! -d "${_localdir}" ] && {
    __logger ${__FAIL} "directory not found ${_localdir}\n"

    return ${__RETURNCODE_SCRIPT_RCLONE_LOCALDIRECTORY_NOTFOUND}
  }

  local _rclone_options=
  [ ${_keep_last_increment} -gt 0 ] && {
    local _rclone_options=("--backup-dir=${_s3path}/${__s3_increment}/${_CURRENT_DATE}")
  }

  __rclone_run --command=sync \
               --extra="${_rclone_options[@]}" \
               --args="${_localdir} ${_s3path}/main/${_localdir}"

  return $?
}

__rclone_copy_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --file=*)
        local _localfile="${key#*=}"
        ;;
    esac
    shift
  done

  [ -f "${_localfile}" ] && {
    __logger ${__FAIL} localfile not found in path ${_localfile}\n

    return ${__RETURNCODE_SCRIPT_RCLONE_LOCALFILE_NOTFOUND}
  }

  __logger ${__INFO} file ${_localfile} to ${_s3path}\n

  __rclone_run --command=copy --args="${_localfile} ${_s3path}"

  local retval=$?
  [ ${retval} -ne 0 ] && {
    __logger ${__FAIL} can not copy ${_localfile} to ${_s3path}\n
  }

  return ${retval}
}


__rclone_copy_complete() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --file=*)
        local _localfile="${key#*=}"
        ;;
      --keep-daily=*)
        local _keep_last_daily="${key#*=}"
        ;;
      --keep-weekly=*)
        local _keep_last_weekly="${key#*=}"
        ;;
      --keep-monthly=*)
        local _keep_last_monthly="${key#*=}"
        ;;
      --keep-annually=*)
        local _keep_last_annually="${key#*=}"
        ;;
    esac
    shift
  done

  local _run_annually=$(/bin/date -d ${_CURRENT_DATE} +%j)
  local _run_monthly=$(/bin/date -d ${_CURRENT_DATE} +%d)
  local _run_weekly=$(/bin/date -d ${_CURRENT_DATE} +%u)
  local _run_daily=${_keep_last_daily:-0}

  local s3path=("${_s3path}${__s3_complete_daily}/${_CURRENT_DATE}")

  [ ${_keep_last_annually} -gt 0 ] && [ "${_run_annually}" == "001" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_annually}/${_CURRENT_DATE}")
  }

  [ ${_keep_last_monthly} -gt 0 ] && [ "${_run_monthly}" == "01" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_monthly}/${_CURRENT_DATE}")
  }

  [ ${_keep_last_weekly} -gt 0 ] && [ "${_run_weekly}" == "1" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_weekly}/${_CURRENT_DATE}")
  }

  for s3 in ${s3path[@]}; do
    __rclone_copy_run --file=${_localfile} --s3-path=${s3}
  done
}

# $1 => mode (0|1)
#      0 => increment
#      1 => complete
# $2 => s3 object, full path, <rclone-profile>:/s3-object/<hostname>/<script-name>
# $3 => temporal directory to save backups in local
__keep_last_backups() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --mode=*)
        local _mode="${key#*=}"
        ;;
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --tmpdir=*)
        local _tmpdir="${key#*=}"
        ;;
      --increment-keep=*)
        local _keep_last_increment=${key#*=}
        ;;
      --complete-keep-daily=*)
        local _keep_last_daily="${key#*=}"
        ;;
      --complete-keep-weekly=*)
        local _keep_last_weekly="${key#*=}"
        ;;
      --complete-keep-monthly=*)
        local _keep_last_monthly="${key#*=}"
        ;;
      --complete-keep-annually=*)
        local _keep_last_annually="${key#*=}"
        ;;
    esac
    shift
  done

  [ "${_mode}" != "${__BACKUP_MODE_INCREMENT}" ] && {
    __keep ${_s3path}${__s3_increment} ${_keep_last_increment}
  }

  [ "${_mode}" != "${__BACKUP_MODE_COMPLETE}" ] && {
    local _run_annually=$(/bin/date -d ${_CURRENT_DATE} +%j)
    local _run_monthly=$(/bin/date -d ${_CURRENT_DATE} +%d)
    local _run_weekly=$(/bin/date -d ${_CURRENT_DATE} +%u)
    local _run_daily=${_keep_last_daily:-0}

    [ ${_keep_last_annually} -gt 0 ] && {
      [ "${_run_annually}" == "001" ] && \
        __keep ${_s3path}${__s3_complete_annually} ${_keep_last_annually}
    }

    [ ${_keep_last_monthly} -gt 0 ] && {
      [ "${_run_monthly}" == "01" ] && \
        __keep ${_s3path}${__s3_complete_monthly} ${_keep_last_monthly}
    }

    [ ${_keep_last_weekly} -gt 0 ] && {
      [ "${_run_weekly}" == "1" ] && \
        __keep ${_s3path}${__s3_complete_weekly} ${_keep_last_weekly}
    }

    [ ${_run_daily} -gt 0 ] && \
      __keep ${_s3path}${__s3_complete_daily} ${_keep_last_daily}
  }
}


# $1 -> remote directory
# $2 -> keep last backups
__keep() {
  local _remote_dir=$1
  local _keep_last=$2

  __logger ${__INFO} keep last ${_keep_last} backups, path: ${_remote_dir}\n

  local _retention=($(/usr/bin/rclone --config=${_CONFIG_RCLONE} lsd ${remote_dir} | \
                      /usr/bin/awk '{print $5}' | \
                      /usr/bin/sort))

  while [ ${#_retention[@]} -gt ${_keep_last} ]; do
    local __remove_filename=${_remote_dir}/${_retention[0]}

    __logger ${__INFO} trying remove directory ${__remove_filename}\n

    echo "/usr/bin/rclone --config=${_CONFIG_RCLONE} delete ${__remove_filename}"
    [ $? -ne 0 ] && {
      __logger ${__FAIL} can not remove ${__remove_filename}\n
    }

    local _retention=(${_retention[@]:1:${#_retention[@]}})  # remove first element
  done
}


# populates default vars
#
set_script_vars() {
  local varnames=($(set | /bin/grep '^__DEFAULT'))

  for varname in ${varnames[@]}; do
    local _vname=${varname/'__DEFAULT'/}
    local _exists=$(set | /bin/grep "^${_vname%%=*}")

    [ "${_exists}" == "" ] && {
      __logger ${__INFO} "default value to var ${_vname}\n"

      eval "${_vname}"
    }
  done
}


unset_script_vars() {
  local fileconf=$1

  IFS=$'\n'
  for varname in $(/bin/cat ${fileconf} | /bin/sed -e '/^#/d' -e '/^$/d'); do
    __logger ${__INFO} "unset ${varname%%=*}\n"
    unset ${varname%%=*}
  done
}

#
# function populates global vars
# $1 script name
checking_global_vars() {
  local envname=${1^^}

  [[ "${envname}" =~ ^[a-zA-Z_]*$ ]] || {
    return ${__RETURNCODE_CHECKING_GLOBAL_VARS}
  }

  local varnames=($(set | /bin/grep '^__DEFAULT'))

  for varname in ${varnames[@]}; do
    local _vname=${envname}${varname/'__DEFAULT'/}
    local _exists=$(set | /bin/grep "^${_vname%%=*}")
    [ "${_exists}" == "" ] && {
      eval "${_vname}"
    }

  done

  return ${__RETURNCODE_OK}
}
