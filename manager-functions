# Utils for handler.sh

__OK=Success:
__FAIL=Failure:
__ERROR=Error:
__WARN=Warning:
__INFO=Info:
__DEBUG=Debug:
__NOTHING=${__INFO}

## Logging functions
__logger() {
  while [ $# -ge 1 ]; do
    local key=$1
    case $key in
      --icon=*)
        local __icon="${key#*=}"
        ;;
      --msg=*)
        local __msg="${key#*=}"
        ;;
    esac
    shift
  done

  local logmsg="[$(/bin/date '+%Y-%m-%d %H:%M:%S')] ${__icon} ${__msg}\n"

  ${_DEBUG:-false} && {
    echo -en ${logmsg}
  }

  ! ${_QUIET} && [ "${__icon}" != "${__DEBUG}" ] && {
    echo -en ${logmsg}
  }

  ${_LOGGING} && [ "${__icon}" != "${__DEBUG}" ] && {
    echo -en ${logmsg} >> ${_LOGFILE}
  }

  [ "${__icon}" == "${__ERROR}" ] && \
    exit 1

  return 0
}


# $1 -> script name
# $@ -> message
__log_script_msg() {
  while [ $# -ge 1 ]; do
    local key=$1
    case $key in
      --script-name=*)
        local __script_name="${key#*=}"
        ;;
      --icon=*)
        local __icon="${key#*=}"
        ;;
      --msg=*)
        local __msg="${key#*=}"
        ;;
    esac
    shift
  done

  __logger --icon=${__icon} --msg="[${__script_name}] ${__msg}"
}


__locked() {
  [ ! -d "${_PIDFILE%/*}" ] && /bin/mkdir -p "${_PIDFILE%/*}"
  [ ! -f "${_PIDFILE}" ] && /bin/touch "${_PIDFILE}"
  local pid=$(/bin/cat "${_PIDFILE}")

  [ -n "${pid}" ] && /bin/ps -p "${pid}" > /dev/null && \
    __logger --icon=${__ERROR} --msg="There is a process in progress, ${pid}"

  /bin/echo $$ > "${_PIDFILE}"
}


__send_notification() {
  #_send_email "email_addr" "subject" "Message" "email_cc"
  local email_to="$1"
  local subject="$2"
  local message="$3"
  local email_cc="$4"
  local email_from="backup@`/bin/hostname -f`"
  {
    /bin/printf "From: ${email_from}\n"
    /bin/printf "To: ${email_to}\n"
    [ -n "${email_cc}" ] && /bin/printf "CC: ${email_cc}\n"
    /bin/printf "Subject: ${subject}\n"
    /bin/printf "X-Mailer: Backup\n"
    /bin/printf "MIME-Version: 1.0\n"
    /bin/printf "Content-Transfer-Encoding: 8bit\n"
    /bin/printf "Content-Type: text/plain; charset=UTF-8\n"
    /bin/echo ""
    /bin/cat "${message}"
  } | /usr/sbin/sendmail -oi -t
}


__BACKUP_MODE_INCREMENT=increment
__BACKUP_MODE_COMPLETE=complete

__s3_increment=/${__BACKUP_MODE_INCREMENT}
__s3_complete_annually=/${__BACKUP_MODE_COMPLETE}/annually
__s3_complete_monthly=/${__BACKUP_MODE_COMPLETE}/monthly
__s3_complete_weekly=/${__BACKUP_MODE_COMPLETE}/weekly
__s3_complete_daily=/${__BACKUP_MODE_COMPLETE}/daily


__rclone_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --command=*)
        local _command="${key#*=}"
        ;;
      --extra=*)
        local _extra="${key#*=}"
        ;;
      --args=*)
        local _args="${key#*=}"
        ;;
    esac
    shift
  done

  eval /usr/bin/rclone --config=${_CONFIG_RCLONE} \
    ${_RCLONE_EXTRA_OPTIONS[@]} \
    ${_command} ${_extra} ${_args}

  return $?
}

__rclone_sync_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --directory=*)
        local _localdir="${key#*=}"
        ;;
      --keep-increment=*)
        local _keep_last_increment="${key#*=}"
        ;;
    esac
    shift
  done

  [ ! -d "${_localdir}" ] && {
    __logger --icon=${__FAIL} --msg="directory not found ${_localdir}"

    return ${__RETURNCODE_SCRIPT_RCLONE_LOCALDIRECTORY_NOTFOUND}
  }

  local _rclone_options=
  [ ${_keep_last_increment:-0} -gt 0 ] && {
    local _rclone_options=("--backup-dir=${_s3path}${__s3_increment}/${_CURRENT_DATE}")
  }

  __rclone_run --command=sync \
               --extra="${_rclone_options[@]}" \
               --args="${_localdir} ${_s3path}/main${_localdir}"

  return $?
}

__rclone_copy_run() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --file=*)
        local _localfile="${key#*=}"
        ;;
      --keep-increment=*)
        local _keep_last_increment="${key#*=}"
        ;;
    esac
    shift
  done

  [ ! -f "${_localfile}" ] && {
    __logger --icon=${__FAIL} --msg="localfile not found in path ${_localfile}"

    return ${__RETURNCODE_SCRIPT_RCLONE_LOCALFILE_NOTFOUND}
  }

  __logger --icon="${__INFO}" --msg="file ${_localfile} to ${_s3path}"

  local _rclone_options=
  [ ${_keep_last_increment:-0} -gt 0 ] && {
    local _rclone_options=("--backup-dir=${_s3path}${__s3_increment}/${_CURRENT_DATE}")
  }

  local _localdir=$(dirname ${_localfile})

  [ "${_localdir:0:1}" != "/" ] && \
    local _localdir="/${_localdir}"

  __rclone_run --command=copy \
               --extra="${_rclone_options[@]}" \
               --args="${_localfile} ${_s3path}/main${_localdir}"

  local retval=$?
  [ ${retval} -ne 0 ] && {
    __logger --icon=${__FAIL} --msg="can not copy ${_localfile} to ${_s3path}"
  }

  return ${retval}
}


__rclone_copy_complete() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --file=*)
        local _localfile="${key#*=}"
        ;;
      --keep-daily=*)
        local _keep_last_daily="${key#*=}"
        ;;
      --keep-weekly=*)
        local _keep_last_weekly="${key#*=}"
        ;;
      --keep-monthly=*)
        local _keep_last_monthly="${key#*=}"
        ;;
      --keep-annually=*)
        local _keep_last_annually="${key#*=}"
        ;;
    esac
    shift
  done

  local _run_annually=$(/bin/date -d ${_CURRENT_DATE} +%j)
  local _run_monthly=$(/bin/date -d ${_CURRENT_DATE} +%d)
  local _run_weekly=$(/bin/date -d ${_CURRENT_DATE} +%u)
  local _run_daily=${_keep_last_daily:-0}

  local s3path=("${_s3path}${__s3_complete_daily}/${_CURRENT_DATE}")

  [ ${_keep_last_annually} -gt 0 ] && [ "${_run_annually}" == "001" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_annually}/${_CURRENT_DATE}")
  }

  [ ${_keep_last_monthly} -gt 0 ] && [ "${_run_monthly}" == "01" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_monthly}/${_CURRENT_DATE}")
  }

  [ ${_keep_last_weekly} -gt 0 ] && [ "${_run_weekly}" == "1" ] && {
    local s3path=(${s3path[@]} "${_s3path}${__s3_complete_weekly}/${_CURRENT_DATE}")
  }

  for s3 in ${s3path[@]}; do
    __rclone_copy_run --file=${_localfile} --s3-path=${s3}
  done
}


# keep last backups
#
__keep_last_backups() {
  while [ $# -ge 1 ]; do
    local key=$1
    case ${key} in
      --mode=*)
        local _mode="${key#*=}"
        ;;
      --s3-path=*)
        local _s3path="${key#*=}"
        ;;
      --tmpdir=*)
        local _tmpdir="${key#*=}"
        ;;
      --increment-keep=*)
        local _keep_last_increment=${key#*=}
        ;;
      --complete-keep-daily=*)
        local _keep_last_daily="${key#*=}"
        ;;
      --complete-keep-weekly=*)
        local _keep_last_weekly="${key#*=}"
        ;;
      --complete-keep-monthly=*)
        local _keep_last_monthly="${key#*=}"
        ;;
      --complete-keep-annually=*)
        local _keep_last_annually="${key#*=}"
        ;;
    esac
    shift
  done

  __logger --icon="${__INFO}" --msg="backup mode ${_mode}"

  [ "${_mode}" == "${__BACKUP_MODE_INCREMENT}" ] && {
    __logger --icon="${__INFO}" --msg="path: ${_s3path}${__s3_increment} - keep last ${_keep_last_increment:-unlimit} backups"

    __keep ${_s3path}${__s3_increment} ${_keep_last_increment}
  }

  [ "${_mode}" == "${__BACKUP_MODE_COMPLETE}" ] && {
    local _run_annually=$(/bin/date -d ${_CURRENT_DATE} +%j)
    local _run_monthly=$(/bin/date -d ${_CURRENT_DATE} +%d)
    local _run_weekly=$(/bin/date -d ${_CURRENT_DATE} +%u)
    local _run_daily=${_keep_last_daily:-0}

    [ "${_run_annually}" == "001" ] && {
      __logger --icon="${__INFO}" --msg="annually: path: ${_s3path}${__s3_complete_annually} - keep last ${_keep_last_annually:-unlimit} backups"

      [ ${_keep_last_annually:-0} -gt 0 ] && \
        __keep ${_s3path}${__s3_complete_annually} ${_keep_last_annually}
    }

    [ "${_run_monthly}" == "01" ] && {
      __logger --icon="${__INFO}" --msg="monthly: path: ${_s3path}${__s3_complete_monthly} - keep last ${_keep_last_monthly:-unlimit} backups"

      [ ${_keep_last_monthly:-0} -gt 0 ] && \
        __keep ${_s3path}${__s3_complete_monthly} ${_keep_last_monthly}
    }

    [ "${_run_weekly}" == "1" ] && {
      __logger --icon="${__INFO}" --msg="weekly: path: ${_s3path}${__s3_complete_weekly} - keep last ${_keep_last_weekly:-unlimit} backups"

      [ ${_keep_last_weekly:-0} -gt 0 ] && \
        __keep ${_s3path}${__s3_complete_weekly} ${_keep_last_weekly}
    }

    __logger --icon="${__INFO}" --msg="daily: path: ${_s3path}${__s3_complete_daily} - keep last ${_keep_last_daily:-unlimit} backups"

    [ ${_run_daily} -gt 0 ] && {
      __keep ${_s3path}${__s3_complete_daily} ${_keep_last_daily}
    }
  }
}


# $1 -> remote directory
# $2 -> keep last backups
__keep() {
  local _remote_dir=$1
  local _keep_last=$2

  __logger --icon="${__INFO}" --msg="keep last ${_keep_last} backups, path: ${_remote_dir}"

  local _retention=($(/usr/bin/rclone --config=${_CONFIG_RCLONE} lsd ${_remote_dir} | \
                      /usr/bin/awk '{print $5}' | \
                      /usr/bin/sort))

  __logger --icon="${__INFO}" --msg="retentions ${#_retention[@]} of ${_keep_last:-unlimit}"

  while [ ${#_retention[@]} -gt ${_keep_last:-0} ]; do
    local __remove_filename=${_remote_dir}/${_retention[0]}

    __logger --icon="${__INFO}" --msg="trying remove directory ${__remove_filename}"

    __rclone_run --command=delete --args=${__remove_filename}

    [ $? -ne 0 ] && \
      __logger --icon=${__FAIL} --msg="can not remove ${__remove_filename}" || \
      __logger --icon="${__INFO}" --msg="remove directory ${__remove_filename}"

    local _retention=(${_retention[@]:1:${#_retention[@]}})  # remove first element
  done
}


# run script if is needly
# return 1 => false
#        0 => true
__run_script() {
  ${_RUN_BACKUP} && {
    [ "${_RUN_BACKUP_IN}" == "daily" ] && \
      return 0

    local _run_weekly=$(/bin/date -d ${_CURRENT_DATE} +%u)
    [ "${_RUN_BACKUP_IN}" == "weekly" ] && \
    [ "${_run_weekly}" == "${_RUN_BACKUP_IN_DAY}" ] && \
      return 0

    local _run_monthly=$(/bin/date -d ${_CURRENT_DATE} +%d)
    [ "${_RUN_BACKUP_IN}" == "monthly" ] && \
    [ "${_run_monthly}" == "${_RUN_BACKUP_IN_DAY}" ] && \
      return 0

    local _run_annually=$(/bin/date -d ${_CURRENT_DATE} +%j)
    [ "${_RUN_BACKUP_IN}" == "annually" ] && \
    [ "${_run_annually}" == "${_RUN_BACKUP_IN_DAY}" ] && \
      return 0
  }

  return 1
}


# set default vars
#
set_script_vars() {
  IFS=$'\n'

  local varnames=($(set | /bin/grep '^__DEFAULT'))

  for varname in ${varnames[@]}; do
    local _vname=${varname/'__DEFAULT'/}
    local _exists=$(set | /bin/grep "^${_vname%%=*}=")

    [ "${_exists}" == "" ] && {
      __logger --icon="${__DEBUG}" --msg="default value to var ${_vname}"

      eval "${_vname}"
    }
  done

  IFS=${__RESTORE_IFS}
}


# unset global variables loaded by files conf
#
unset_script_vars() {
  local fileconf=$1

  IFS=$'\n'
  for varname in $(/bin/cat ${fileconf} | /bin/sed -e '/^#/d' -e '/^$/d'); do
    __logger --icon="${__DEBUG}" --msg="unset ${varname%%=*}"
    unset ${varname%%=*}
  done

  unset _LOGFILE
}
